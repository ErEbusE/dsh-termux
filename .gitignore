# Build artifacts (created by scripts/)
node/
work/
downloads/
*.log
*.tgz
# Release asset built locally by build/build-patchset.sh
dsh-termux-patches.tar.gz

# Session scratch space for ad-hoc agent debugging (repro scripts, pristine
# npm copies, shadow node_modules). Never tracked; never holds anything the
# repo needs.
.tmp-debug/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local sandbox test harness: the CODE is tracked, data/artifacts are not.
# git cannot negate inside a directory that is itself ignored, so this
# enumerates top-level members (`.test-install/*`) instead of ignoring the
# directory (`.test-install/`) — a directory-level pattern would silently
# disable every `!` line below.
.test-install/*
!.test-install/run.sh
!.test-install/sandbox-lib.sh
!.test-install/serve.sh
!.test-install/README.md
!.test-install/baseline.env
!.test-install/routes/
# 维护者工具整目录纳管: 可复用工具放进来即自动跟踪, 不必逐文件加白名单
# (AGENTS.md §1)。一次性脚本不留存, 不散落在 .test-install/ 根目录。
!.test-install/tools/

# Legacy alias that the original AGENTS.md ignore also covered
AGENT.md
